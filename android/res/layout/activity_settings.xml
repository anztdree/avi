<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/avi_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Pengaturan" android:textColor="@color/avi_teks"
            android:textSize="26sp" android:textStyle="bold"
            android:paddingBottom="3dp"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Perubahan langsung berlaku — sentuh Simpan untuk memastikan. (b12)"
            android:textColor="@color/avi_teks_samping" android:textSize="13sp"
            android:paddingBottom="14dp"/>

        <!-- ===== Penyedia AI ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Penyedia AI"/>
            <RadioGroup
                android:id="@+id/rgPenyedia"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbGemini" style="@style/PilihanSetting" android:text="Google Gemini"/>
                <RadioButton android:id="@+id/rbNvidia" style="@style/PilihanSetting" android:text="NVIDIA NIM"/>
                <RadioButton android:id="@+id/rbOpenrouter" style="@style/PilihanSetting" android:text="OpenRouter"/>
            </RadioGroup>
            <TextView
                android:id="@+id/tvPetunjukKey"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingTop="6dp"/>
            <EditText
                android:id="@+id/etKey"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Tempel API key di sini"
                android:textColor="@color/avi_teks"
                android:textColorHint="@color/avi_teks_samping"
                android:textSize="14sp"
                android:inputType="text"
                android:maxLines="3"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <!-- ===== Model ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Model"/>
            <TextView
                android:id="@+id/tvModel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks" android:textSize="14sp"/>
            <Button
                android:id="@+id/bModel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ambil &amp; pilih model"
                android:textAllCaps="false"
                android:background="@drawable/btn_primary"
                android:textColor="#FFFFFF"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingTop="6dp"
                android:text="Daftar model diambil langsung dari penyedia. Untuk Gemini, gemini-flash-lite-latest disematkan di atas karena responsnya cepat."/>
        </LinearLayout>

        <Button
            android:id="@+id/bTes"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tes koneksi"
            android:textAllCaps="false"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/avi_teks"
            android:layout_marginBottom="12dp"/>

        <!-- ===== Nama pemilik ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Nama pemilik"/>
            <EditText
                android:id="@+id/etNamaPemilik"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/hint_nama_pemilik"
                android:textColor="@color/avi_teks"
                android:textColorHint="@color/avi_teks_samping"
                android:textSize="14sp"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingTop="6dp"
                android:text="Bebas isi apa pun — cukup nama saja. Jika kosong, AVI memanggil Anda \u201CSir\u201D."/>
        </LinearLayout>

        <!-- ===== Tampilan: cerah utama, gelap selingan (pilihan pemilik) ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Tampilan"/>
            <RadioGroup
                android:id="@+id/rgTema"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbCerah" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="Cerah (utama)"/>
                <RadioButton android:id="@+id/rbGelap" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="Gelap"/>
            </RadioGroup>
        </LinearLayout>

        <!-- ===== Suara ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Suara"/>
            <Switch
                android:id="@+id/swTts"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Bacakan balasan AVI (TTS)"
                android:textColor="@color/avi_teks" android:textSize="14sp"
                android:paddingBottom="6dp"/>
            <TextView
                android:id="@+id/tvRate"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"/>
            <SeekBar
                android:id="@+id/sbRate"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="100"/>
            <Button
                android:id="@+id/bSuara"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pilih suara TTS"
                android:textAllCaps="false"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/avi_teks"/>
            <TextView
                android:id="@+id/tvSuara"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingTop="6dp"/>
        </LinearLayout>

        <!-- ===== Kalibrasi suara (permintaan pemilik: kalibrasi perintah dgn suara pemilik) ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Kalibrasi suara"/>
            <TextView
                android:id="@+id/tvKalibrasi"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks" android:textSize="14sp"
                android:paddingBottom="8dp"/>
            <Button
                android:id="@+id/bKalibrasi"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Buka layar kalibrasi"
                android:textAllCaps="false"
                android:background="@drawable/btn_primary"
                android:textColor="#FFFFFF"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingTop="10dp" android:paddingBottom="2dp"
                android:text="Gerbang sapaan di Mode Live:"/>
            <RadioGroup
                android:id="@+id/rgGerbang"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rbGMati"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nonaktif" android:textSize="13sp"
                    android:textColor="@color/avi_teks"/>
                <RadioButton
                    android:id="@+id/rbGLembut"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lembut" android:textSize="13sp"
                    android:textColor="@color/avi_teks"/>
                <RadioButton
                    android:id="@+id/rbGKetat"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ketat" android:textSize="13sp"
                    android:textColor="@color/avi_teks"/>
            </RadioGroup>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingTop="6dp"
                android:text="Pendaftaran satu alur otomatis: ruangan → profil suara → kunci sapaan &quot;Hai AVI&quot;. Setelah berhasil layar terkunci — tersisa Reset ulang dan Hapus. Lembut: suara kurang cocok tetap dilayani; Ketat: 3× gagal, AVI menolak. Semua dihitung di ponsel — tanpa unggah."/>
        </LinearLayout>

        <!-- ===== Mode Live ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Mode Live"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingBottom="4dp"
                android:text="Berapa lama obrolan boleh hening sebelum AVI pamit dan tidur."/>
            <RadioGroup
                android:id="@+id/rgHening"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbH5" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="5 dtk"/>
                <RadioButton android:id="@+id/rbH8" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="8 dtk"/>
                <RadioButton android:id="@+id/rbH12" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="12 dtk"/>
                <RadioButton android:id="@+id/rbH15" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="15 dtk"/>
            </RadioGroup>
        </LinearLayout>

        <!-- ===== Daya ingat AI ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Daya ingat AI"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingBottom="4dp"
                android:text="Berapa pesan terakhir yang ikut jadi konteks jawaban. Semakin besar, semakin paham — tapi lebih boros kuota API."/>
            <RadioGroup
                android:id="@+id/rgIngat"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbIngat10" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="10"/>
                <RadioButton android:id="@+id/rbIngat20" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="20"/>
                <RadioButton android:id="@+id/rbIngat50" style="@style/PilihanSetting"
                    android:layout_weight="1" android:text="50"/>
            </RadioGroup>
        </LinearLayout>

        <!-- ===== Asisten perangkat ===== -->
        <LinearLayout style="@style/KartuSetting">
            <TextView style="@style/JudulKartu" android:text="Asisten perangkat"/>
            <TextView
                android:id="@+id/tvAsistenStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks" android:textSize="14sp"
                android:paddingBottom="8dp"/>
            <Button
                android:id="@+id/bAsisten"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Jadikan AVI asisten perangkat"
                android:textAllCaps="false"
                android:background="@drawable/btn_primary"
                android:textColor="#FFFFFF"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"
                android:paddingTop="6dp"
                android:text="Setelah AVI terpilih, tahan tombol home di layar mana pun (navigasi gestur: sapu dari sudut kiri/kanan bawah) — kartu obrolan transparan AVI muncul di atas aplikasi, seperti Google Assistant. Pemicu dipegang sistem Android: tidak ada layanan latar, baterai tetap aman. Jika AVI belum muncul dalam daftarnya, reboot HP lalu buka lagi."/>
        </LinearLayout>

        <Button
            android:id="@+id/bSimpan"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:text="Simpan pengaturan"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/bBersihkan"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Bersihkan riwayat chat"
            android:textAllCaps="false"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/avi_teks"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/versi"
            android:textColor="@color/avi_teks_samping" android:textSize="12sp"
            android:paddingBottom="24dp"/>
    </LinearLayout>
</ScrollView>
