<?xml version="1.0" encoding="utf-8"?>
<!-- ===================== MODE LIVE "AVI Arc" =====================
     Panggung sinematik: orb besar di atas pendaran kanvas, status sian,
     transkrip dalam kartu kaca (Anda = garis sian, AVI = panel gelap).
================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnTutupLive"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tutup" android:textColor="@color/avi_teks"
            android:textSize="13sp" android:textStyle="bold"
            android:background="@drawable/btn_pil"
            android:paddingLeft="18dp" android:paddingRight="18dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"/>

        <Space
            android:layout_width="0dp" android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginRight="26dp"
            android:text="MODE LIVE" android:textColor="@color/aksen_pudar"
            android:textSize="12sp" android:textStyle="bold"
            android:letterSpacing="0.24"/>
    </LinearLayout>

    <com.avi.assistant.OrbView
        android:id="@+id/orbLive"
        android:layout_width="236dp" android:layout_height="236dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/tvStatusLive"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/aksen_pudar" android:textSize="15sp"
        android:layout_marginTop="10dp"
        android:paddingLeft="24dp" android:paddingRight="24dp"/>

    <ScrollView
        android:id="@+id/scrollTranskrip"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp" android:paddingRight="22dp"
            android:paddingBottom="16dp">

            <!-- PAPAN PESAN BERSAMA — riwayat lama yang sama dengan
                 aplikasi AVI & lembar melayang (aturan pemilik). -->
            <LinearLayout
                android:id="@+id/papanLive"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvAndaLive"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/kartu_saran"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:paddingTop="14dp" android:paddingBottom="14dp"
                android:textColor="@color/avi_teks" android:textSize="17sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.25"/>

            <TextView
                android:id="@+id/tvAviLive"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bubble_avi"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:paddingTop="14dp" android:paddingBottom="14dp"
                android:textColor="@color/avi_teks" android:textSize="15sp"
                android:lineSpacingMultiplier="1.35"/>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Hening sebentar — AVI pamit dan tidur. Panggil lagi kapan saja."
        android:textColor="@color/avi_teks_samping" android:textSize="12sp"
        android:paddingBottom="14dp"
        android:paddingLeft="24dp" android:paddingRight="24dp"/>
</LinearLayout>
