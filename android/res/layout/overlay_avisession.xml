<?xml version="1.0" encoding="utf-8"?>
<!-- SESI ASISTEN AVI v1.3 (b20) — PANEL GOOGLE MURNI, disetujui
     pemilik lewat kalibrasi visual web (Task 13-17):

     Yang ADA (persis web yang disetujui):
     - layar belakang HANYA disentuh redup tipis 0,30 (#4D070F0C —
       nyaris terang; app di belakang jelas terlihat);
     - jawaban AVI melayang di ATAS pill, logo 4 titik di kirinya,
       teks diberi BAYANGAN (pola subtitle) agar terbaca di tema
       cerah maupun gelap — TANPA menutup layar;
     - SATU bar di bawah: pill "Tanya AVI…" + tombol suara;
     - KATA-KATA PEMILIK (bicara maupun ketik) tampil DI DALAM pill,
       hilang sendiri saat giliran tuntas (pola web Task 15);
     - tombol suara TIGA PERAN: mic (denyut saat mendengarkan) →
       kirim (ada ketikan) → stop (AVI sedang bicara);
     - usap ke bawah = tutup; KETUK area kosong = tutup.

     Yang TIDAK ada lagi (dibanding b18):
     - tanpa salam "Hai, ...", tanpa tombol ✕, tanpa teks status,
     - tanpa EMPAT TITIK beranimasi (umpan balik dengar cukup dari
       denyut tombol mic — dua elemen = dua fungsi),
     - tanpa petunjuk "usap ke bawah".

     Baru b20 (laporan pemilik): DASAR GELAP menguat dari bawah
     (pola Google Assistan) di zona jawaban + pill — app di belakang
     tidak lagi bertabrakan dengan teks melayang; mic saat
     MENDENGARKAN = tombol SOLID teal + ikon gelap + pill berubah
     "Mendengarkan…" (sebelumnya cuma latar 18% — tak terlihat jelas).

     Mesin menyala otomatis begitu panel tergambar (mic langsung
     siap mendengarkan — Task 17); tanpa izin mic, pill ketik tetap
     hidup. Root menelan sentuhan kosong = tutup.-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/akarSesi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4D070F0C"
    android:clickable="true"
    android:focusable="true">

    <!-- ===== dasar gelap zona bawah (b20, pola Google Assistan):
         jawaban melayang + pill selalu terbaca walau app di
         belakang ramai — layar atas tetap 0,30 terang ===== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradasi_bawah"/>

    <!-- ===== jawaban AVI: melayang, menempel di atas pill ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="92dp">

        <LinearLayout
            android:id="@+id/barisJawabanSesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/logo_avi"
                android:contentDescription="AVI"/>

            <TextView
                android:id="@+id/tvAviSesi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:textColor="#F2F7F5"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.35"
                android:shadowColor="#A6070F0C"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:maxLines="12"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== bar bawah: pill "Tanya AVI…" + tombol suara ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pil_sesi"
            android:paddingLeft="18dp"
            android:paddingRight="6dp">

            <EditText
                android:id="@+id/etPilSesi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Tanya AVI…"
                android:textColor="#F2F7F5"
                android:textColorHint="#A8F2F7F5"
                android:textSize="15sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:contentDescription="Ketik pertanyaan untuk AVI"/>

            <FrameLayout
                android:id="@+id/bSuaraSesi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_tombol_suara"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tombol voice">

                <ImageView
                    android:id="@+id/ikonSuaraSesi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:tint="#2DD4BF"
                    android:contentDescription=""/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
