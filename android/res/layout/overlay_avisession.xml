<?xml version="1.0" encoding="utf-8"?>
<!-- ================= PANEL ASISTEN AVI v2.0 "LEMBAR JARVIS" ============

     Rom bak total atas permintaan pemilik (review v1.9, 21 Okt 2026):
     "tombol home di tekan launcher icon emang gak ada tapi masih ada
     sisa bulat-bulat itu... kenapa harus pake itu, hapus napa biar
     bersih!"

     Yang DIHAPUS total di v2.0 (semua "bulat-bulat" milik AVI):
     - ORB 36dp di atas bubble (titik biru kecil melayang) — HAPUS;
     - sisa logo 4 titik yang bocor dari layar utama di belakang
       panel — akarnya adalah scrim tipis 0,30; kini panel = LEMBAR
       GELAP PENUH (bg_panel_jarvis) sehingga app di belakang TIDAK
       terlihat lagi. Panel berdiri sendiri sebagai konsol AVI.

     Yang TERSISA — hanya yang berfungsi:
     - jawaban AVI dalam bubble kaca gelap di atas pill;
     - SATU bar bawah: pill "Tanya AVI…" + tombol suara tiga peran
       (mic mendengarkan → kirim ketikan → stop saat AVI bicara);
     - kata-kata pemilik HIDUP DI DALAM pill, hilang sendiri saat
       giliran tuntas;
     - usap ke bawah / ketuk area kosong = tutup;
     - mesin menyala otomatis begitu panel tergambar; tanpa izin mic
       pill ketik tetap hidup.

     Catatan jujur (diperbarui v2.1): lingkaran putih yang muncul
     SEKETIKA saat tombol home DITAHAN adalah animasi tekan bawaan
     sistem (SystemUI/ROM) — digambar sistem DI ATAS jendela aplikasi
     mana pun, wadahnya tidak berhak dihapus aplikasi biasa. TAPI
     dulu ia menganga LAMA karena proses AVI harus dingin dulu
     (cold start 1-3 dtk di HP low-RAM) — kini LayananJaga menjaga
     proses hangat 24 jam sehingga panel muncul seketika dan badge
     itu hanya berkedip sepersekian detik; saat panel terbuka navbar
     ikut disembunyikan sehingga area tombol home bersih. ==== -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/akarSesi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel_jarvis"
    android:clickable="true"
    android:focusable="true">

    <!-- ===== jawaban AVI: melayang, menempel di atas pill ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="92dp">

        <LinearLayout
            android:id="@+id/barisJawabanSesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAviSesi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sesi_teks"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.35"
                android:background="@drawable/bubble_jawaban_sesi"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:maxLines="12"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== bar bawah: pill "Tanya AVI…" + tombol suara ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pil_sesi"
            android:paddingLeft="20dp"
            android:paddingRight="7dp">

            <EditText
                android:id="@+id/etPilSesi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Tanya AVI…"
                android:textColor="@color/sesi_teks"
                android:textColorHint="#A88FA3C8"
                android:textSize="15sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:contentDescription="Ketik pertanyaan untuk AVI"/>

            <FrameLayout
                android:id="@+id/bSuaraSesi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_tombol_suara"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tombol voice">

                <ImageView
                    android:id="@+id/ikonSuaraSesi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/sesi_aksen"
                    android:contentDescription=""/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
