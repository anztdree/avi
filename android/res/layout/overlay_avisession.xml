<?xml version="1.0" encoding="utf-8"?>
<!-- ================= PANEL ASISTEN AVI v2.4 "ARK REACTOR" ==============

     TEMA BARU pilihan pemilik (Opsi A, disetujui setelah rencana v2.4):
     "UI di dalam tidak berubah signifikan, saya ingin ganti tema!!"

     Wujud ARK REACTOR:
     - TANPA lembar gelap menutup layar — panel kini TRANSPARAN:
       wallpaper/app di belakang tetap terlihat, hanya diberi scrim
       vertikal tipis + pendaran radial di balik reaktor agar teks
       tetap terbaca di wallpaper mana pun;
     - REAKTOR di tengah layar: OrbView 104dp (inti sian-teal mengalir
       + dua cincin tipis berputar) dengan label keadaan huruf besar
       renggang di bawahnya;
     - jawaban AVI = kartu kaca melayang di atas pill;
     - bar bawah TETAP pola lama yang disetujui pemilik: pill
       "Tanya AVI…" + tombol suara tiga peran (mic/kirim/stop);
     - navbar TIDAK PERNAH disembunyikan (v2.4 membatalkan perilaku
       v2.1 atas koreksi pemilik: "saat tombol home ditekan navigasi
       tidak boleh disembunyikan") — bar bawah menghormati tinggi
       navbar lewat inset sistem dari Java;
     - usap ke bawah / ketuk area kosong = tutup (tetap).
==================================================================== -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/akarSesi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_scrim_reaktor"
    android:clickable="true"
    android:focusable="true">

    <!-- ===== jawaban AVI: kartu kaca melayang, di atas pill ===== -->
    <LinearLayout
        android:id="@+id/zonaJawabanSesi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="168dp">

        <LinearLayout
            android:id="@+id/barisJawabanSesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAviSesi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sesi_teks"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.35"
                android:background="@drawable/bubble_jawaban_sesi"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:maxLines="12"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== REAKTOR: jantung panel, di tengah layar ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <com.avi.assistant.OrbView
            android:id="@+id/orbSesi"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="Reaktor AVI"/>

        <TextView
            android:id="@+id/tvKeadaanSesi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/keadaan_siap"
            android:textColor="@color/sesi_keadaan"
            android:textSize="11sp"
            android:letterSpacing="0.30"
            android:textAllCaps="true"/>
    </LinearLayout>

    <!-- ===== bar bawah: pill "Tanya AVI…" + tombol suara ===== -->
    <LinearLayout
        android:id="@+id/barBawahSesi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pil_sesi"
            android:paddingLeft="20dp"
            android:paddingRight="7dp">

            <EditText
                android:id="@+id/etPilSesi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Tanya AVI…"
                android:textColor="@color/sesi_teks"
                android:textColorHint="#A88FA3C8"
                android:textSize="15sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:contentDescription="Ketik pertanyaan untuk AVI"/>

            <FrameLayout
                android:id="@+id/bSuaraSesi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_tombol_suara"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tombol voice">

                <ImageView
                    android:id="@+id/ikonSuaraSesi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/sesi_aksen"
                    android:contentDescription=""/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
