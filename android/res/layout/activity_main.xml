<?xml version="1.0" encoding="utf-8"?>
<!-- ===================== LAYAR UTAMA "AVI Arc" v1.2 =====================
     Diringkas mengikuti kalibrasi web (Task 11, "efisien yg utama"):
     - Hero: logo 4 titik STATIS (nol animasi) + salam + satu ajakan —
       TANPA orb 136dp bernapas, TANPA kisi kartu saran 2x2.
     - Obrolan: gelembung AVI beravatar kiri / pil gradasi user kanan
     - Input: pil kaca melayang + tombol aksi gradasi
==================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ==== bar atas ==== -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="18dp" android:paddingRight="18dp"
        android:paddingTop="14dp" android:paddingBottom="8dp">

        <ImageView
            android:layout_width="30dp" android:layout_height="30dp"
            android:src="@drawable/orb_mini"
            android:contentDescription="AVI"/>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="AVI" android:textColor="@color/avi_teks"
            android:textSize="19sp" android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <View
            android:layout_width="7dp" android:layout_height="7dp"
            android:layout_marginLeft="9dp"
            android:background="@drawable/titik_status"/>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Siap" android:textColor="@color/avi_teks_samping"
            android:textSize="11sp" android:letterSpacing="0.06"/>

        <Space
            android:layout_width="0dp" android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btnPengaturan"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/lingkaran_ikon"
            android:src="@drawable/ic_gear"
            android:padding="10dp"
            android:contentDescription="Pengaturan"/>
    </LinearLayout>

    <!-- ==== hero (hanya saat obrolan kosong) ==== -->
    <LinearLayout
        android:id="@+id/heroBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="20dp" android:paddingBottom="12dp"
        android:paddingLeft="20dp" android:paddingRight="20dp">

        <ImageView
            android:layout_width="64dp" android:layout_height="14dp"
            android:layout_marginTop="34dp"
            android:src="@drawable/logo_avi"
            android:contentDescription="AVI"/>

        <TextView
            android:id="@+id/tvSalam"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/avi_teks" android:textSize="29sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:textColor="@color/avi_teks_samping" android:textSize="14sp"/>
    </LinearLayout>

    <!-- ==== riwayat obrolan ==== -->
    <ListView
        android:id="@+id/daftarChat"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="6dp" android:paddingBottom="10dp"
        android:scrollbars="none"
        android:clipToPadding="false"/>

    <!-- ==== input melayang ==== -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="6dp" android:paddingBottom="16dp">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_pill"
            android:hint="Tanya apa saja…"
            android:textColor="@color/avi_teks"
            android:textColorHint="@color/avi_teks_samping"
            android:textSize="15sp"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingLeft="22dp" android:paddingRight="22dp"
            android:paddingTop="15dp" android:paddingBottom="15dp"/>

        <ImageView
            android:id="@+id/bAksi"
            android:layout_width="52dp" android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/lingkaran_aksi"
            android:src="@drawable/ic_mic"
            android:padding="14dp"
            android:tint="#FFFFFF"
            android:contentDescription="Kirim / Mode Live"/>
    </LinearLayout>
</LinearLayout>
