<?xml version="1.0" encoding="utf-8"?>
<!--
    KALIBRASI SUARA v3 — WIZARD pendaftaran ala "Voice Match" (b15).
    Enam langkah: selamat datang → ruangan → frasa pendek 1 (3 take)
    → frasa pendek 2 (3 take) → sapaan "Hai AVI" (4 take) → UJI TAMU
    (orang lain HARUS ditolak). Selesai = TERKUNCI (Reset/Hapus saja).
    Gaya visual menyatu dengan Pengaturan (tema Arc cerah).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/avi_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- kepala: ikon mikrofon dalam piringan lembut -->
        <FrameLayout
            android:layout_width="92dp" android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/lingkaran_ikon">
            <ImageView
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:tint="@color/aksen"
                android:contentDescription="Mikrofon"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvJudul"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Kenalkan AVI dengan suara Anda"
            android:textColor="@color/avi_teks"
            android:textSize="23sp" android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvNarasi"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Kurang dari satu menit. Setelah terdaftar, layar ini terkunci."
            android:textColor="@color/avi_teks_samping" android:textSize="13sp"/>

        <!-- tubuh: kartu pemandu -->
        <LinearLayout style="@style/KartuSetting"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvLangkah"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/avi_teks_samping" android:textSize="11sp"
                android:textAllCaps="true" android:letterSpacing="0.12"
                android:text="Siap mendaftar"/>

            <TextView
                android:id="@+id/tvInstruksi"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/avi_teks" android:textSize="15sp"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:id="@+id/tvFrasa"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="@color/aksen" android:textSize="19sp"
                android:textStyle="bold" android:lineSpacingExtra="3dp"/>

            <ProgressBar
                android:id="@+id/pbLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100" android:progress="0"
                android:progressTint="@color/aksen"/>

            <TextView
                android:id="@+id/tvUmpan"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="@color/avi_teks_samping" android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvDots"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="@color/aksen" android:textSize="18sp"
                android:letterSpacing="0.25"/>
        </LinearLayout>

        <Button
            android:id="@+id/bUtama"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mulai pendaftaran"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/bKedua"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="Hapus kalibrasi"
            android:textAllCaps="false"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/avi_teks"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/avi_teks_samping" android:textSize="11sp"
            android:text="Profil suara tersimpan di ponsel Anda saja — tanpa unggah, tanpa server. AVI hanya membandingkan bentuk spektrum &amp; nada dasar, rekaman mentah tidak disimpan."/>
    </LinearLayout>
</ScrollView>
