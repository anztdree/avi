<?xml version="1.0" encoding="utf-8"?>
<!-- Latar depan ikon adaptif AVI: orb menyala — identitas yang sama dengan
     orb di dalam aplikasi. Semua elemen di dalam zona aman 66dp tengah. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- pendar luar -->
    <path android:fillColor="#FFFFFF"
        android:fillAlpha="0.10"
        android:pathData="M54,21 a33,33 0 1,1 -0.01,0 z"/>

    <!-- pendar inti -->
    <path android:fillColor="#FFFFFF"
        android:fillAlpha="0.16"
        android:pathData="M54,27 a27,27 0 1,1 -0.01,0 z"/>

    <!-- cincin luar -->
    <path android:strokeColor="#FFFFFF" android:strokeAlpha="0.45"
        android:strokeWidth="3" android:strokeLineCap="round"
        android:pathData="M54,31 a23,23 0 1,1 -0.01,0 z"/>

    <!-- cincin dalam -->
    <path android:strokeColor="#FFFFFF" android:strokeAlpha="0.80"
        android:strokeWidth="2.5" android:strokeLineCap="round"
        android:pathData="M54,37.5 a16.5,16.5 0 1,1 -0.01,0 z"/>

    <!-- inti terang -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M54,43.5 a10.5,10.5 0 1,1 -0.01,0 z"/>

    <!-- titik aksen: AVI "hidup" -->
    <path android:fillColor="#8FD0FF"
        android:pathData="M63.5,42.5 a3.5,3.5 0 1,1 -0.01,0 z"/>
</vector>
