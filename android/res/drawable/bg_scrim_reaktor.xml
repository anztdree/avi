<?xml version="1.0" encoding="utf-8"?>
<!-- ================= SCRIM ARK REACTOR v2.4 ============================
     Panel TIDAK lagi lembar gelap penuh (v2.0-v2.3) — pemilik memilih
     tema "ARK REACTOR": transparan, wallpaper tetap terlihat.
     Lapisan:
     1) gradasi vertikal tipis — bening di atas, menggelap lembut di
        bawah (zona jawaban + pill tetap terbaca);
     2) pendaran radial lembut di tengah — panggung reaktor.
==================================================================== -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#73081019"
                android:centerColor="#33081019"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="300dp"
        android:height="300dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#2E38BDF8"
                android:endColor="#0038BDF8"/>
        </shape>
    </item>
</layer-list>
