<?xml version="1.0" encoding="utf-8"?>
<!-- BUBBLE JAWABAN AVI v2.0 — kaca gelap bersudut lembut dengan garis
     sian tipis, satu keluarga dengan lembar JARVIS (bg_panel_jarvis)
     dan pill input. Permintaan pemilik: panel harus bersih tanpa
     hiasan; bubble polos fungsional saja. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6111C30"/>
    <corners android:topLeftRadius="6dp"
        android:topRightRadius="20dp"
        android:bottomRightRadius="20dp"
        android:bottomLeftRadius="20dp"/>
    <stroke android:width="1dp" android:color="@color/sesi_garis"/>
</shape>
