<?xml version="1.0" encoding="utf-8"?>
<!-- Kanvas Arc: dasar warna tema + pendaran sian kiri-atas dan indigo
     kanan-bawah (intensitas mengikuti tema cerah/gelap lewat warna glow). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/avi_bg"/>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial"
                android:centerX="0.12" android:centerY="0.02"
                android:gradientRadius="340dp"
                android:startColor="@color/glow_cyan"
                android:endColor="#0019B4E8"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial"
                android:centerX="0.92" android:centerY="0.98"
                android:gradientRadius="380dp"
                android:startColor="@color/glow_indigo"
                android:endColor="#002F6BFF"/>
        </shape>
    </item>
</layer-list>
