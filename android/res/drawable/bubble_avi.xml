<?xml version="1.0" encoding="utf-8"?>
<!-- Gelembung AVI: panel kaca gelap dengan garis tepi tipis kebiruan,
     sudut kanan-bawah lancip (ekor keluar dari avatar). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:radius="20dp"
        android:bottomRightRadius="5dp"/>
    <solid android:color="@color/gelembung_avi"/>
    <stroke android:width="1dp" android:color="@color/garis_terang"/>
</shape>
