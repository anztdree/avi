<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu kaca sesi asisten: hampir pekat agar terbaca di atas aplikasi
     mana pun, merapat ke bawah layar, radius atas lebar + garis sian samar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="32dp"
        android:topRightRadius="32dp"/>
    <solid android:color="@color/kaca_sesi"/>
    <stroke android:width="1dp" android:color="@color/garis_terang"/>
</shape>
